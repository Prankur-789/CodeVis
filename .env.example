# Copy this file to .env and adjust as needed.
# The backend reads these via os.environ with sensible defaults, so none
# are strictly required to run locally -- see backend/execution/sandbox.py.

# --- Server ---
PORT=5001
FLASK_DEBUG=0

# --- Sandbox resource limits (see backend/execution/sandbox.py) ---
CODEVIS_CPU_LIMIT=5
CODEVIS_WALL_LIMIT=8
CODEVIS_MEM_LIMIT_MB=256
CODEVIS_MAX_PROCS=16
CODEVIS_MAX_OUTPUT_BYTES=204800

# --- Frontend (set in a small inline script tag before js/main.js loads,
#     or template this value in at deploy time) ---
# CODEVIS_API_BASE=https://your-backend.example.com
